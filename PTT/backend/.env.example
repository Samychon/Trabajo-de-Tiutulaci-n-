# Generate a URL-safe password with: openssl rand -hex 24
DATABASE_URL=postgresql+psycopg2://ipi2_user:REPLACE_WITH_UNIQUE_HEX_PASSWORD@localhost:5432/ipi2_inventario

# Generar con: openssl rand -hex 32
JWT_SECRET_KEY=changeme-generate-with-openssl-rand-hex-32

# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DEVICE_SECRET_ENCRYPTION_KEY=changeme-generate-with-fernet-generate-key

ALLOWED_ORIGINS=["http://localhost:5173"]
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development
